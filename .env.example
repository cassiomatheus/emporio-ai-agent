# Ambiente da execução mínima: development, test ou production.
# Não inclua segredos neste arquivo versionado.
EMPORIO_ENVIRONMENT=development

# Sem valores, nenhuma API de LLM é chamada. Escolha modelo e orçamento antes de ativar.
EMPORIO_LLM_PROVIDER=
EMPORIO_LLM_MODEL=
EMPORIO_LLM_API_KEY=
# Alternativa de credencial: OPENAI_API_KEY. Não versionar o .env real.
# openai usa o endpoint oficial se não informado; openai_compatible exige URL Responses.
EMPORIO_LLM_BASE_URL=
# Opt-in para modelos que não cumprem AnswerPlan: uma finalização JSON limitada,
# somente após encerrar tools. Timeout inclui as duas requisições; uso é somado.
EMPORIO_LLM_STRUCTURED_FINALIZATION=false
# Opcionais: não são enviados ao provedor enquanto vazios. Suporte varia por modelo.
EMPORIO_LLM_TEMPERATURE=
EMPORIO_LLM_REASONING_EFFORT=
EMPORIO_LLM_TIMEOUT_SECONDS=20
EMPORIO_LLM_MAX_OUTPUT_TOKENS=1200
EMPORIO_AGENT_TIMEOUT_SECONDS=30
EMPORIO_AGENT_TOOL_TIMEOUT_SECONDS=5
EMPORIO_AGENT_MAX_ROUNDS=4
EMPORIO_AGENT_MAX_TOOL_CALLS=12

# Memória efêmera por sessão; autenticação real não está implementada.
EMPORIO_SESSION_MAX_TURNS=6
EMPORIO_SESSION_MAX_CHARACTERS=12000
EMPORIO_SESSION_TTL_SECONDS=1800
EMPORIO_SESSION_MAX_SESSIONS=100
EMPORIO_SESSION_MAX_CLIENTS=100
EMPORIO_SESSION_LOCK_TIMEOUT_SECONDS=30

# real exige configuração explícita de LLM; offline_demo é roteiro simulado sem rede.
EMPORIO_CHAT_MODE=real
EMPORIO_CHAT_CATALOG_DATABASE=data/emporio.sqlite3
# Banco separado, preparado com data/samples; nunca use o original neste campo.
EMPORIO_CHAT_DEMO_DATABASE=data/demo.sqlite3
# Opcional e local. Ausente: tools de políticas retornam indisponibilidade.
EMPORIO_CHAT_POLICY_PDF=
