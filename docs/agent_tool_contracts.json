  {
    "name": "get_product_offers",
    "description": "Consulta ofertas de um produto. Para N parcelas envie payment_method='credit' e installments=N. Não calcule valores nem substitua um plano rejeitado.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Product Id",
          "type": "integer"
        },
        "payment_method": {
          "anyOf": [
            {
              "enum": [
                "pix",
                "credit",
                "debit",
                "boleto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Method"
        },
        "installments": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installments"
        }
      },
      "required": [
        "product_id"
      ],
      "title": "ProductOffersInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "InstallmentPlan": {
          "additionalProperties": false,
          "properties": {
            "count": {
              "title": "Count",
              "type": "integer"
            },
            "amounts": {
              "items": {
                "decimal_places": 2,
                "ge": 0,
                "le": "92233720368547758.07",
                "type": "string"
              },
              "title": "Amounts",
              "type": "array"
            },
            "total_brl": {
              "decimal_places": 2,
              "ge": 0,
              "le": "92233720368547758.07",
              "title": "Total Brl",
              "type": "string"
            },
            "minimum_brl": {
              "decimal_places": 2,
              "ge": 0,
              "le": "92233720368547758.07",
              "title": "Minimum Brl",
              "type": "string"
            },
            "interest_percent": {
              "default": "0",
              "title": "Interest Percent",
              "type": "string"
            }
          },
          "required": [
            "count",
            "amounts",
            "total_brl",
            "minimum_brl"
          ],
          "title": "InstallmentPlan",
          "type": "object"
        },
        "PaymentOffer": {
          "additionalProperties": false,
          "properties": {
            "payment_method": {
              "enum": [
                "pix",
                "credit",
                "debit",
                "boleto"
              ],
              "title": "Payment Method",
              "type": "string"
            },
            "discount_percent": {
              "title": "Discount Percent",
              "type": "string"
            },
            "final_price": {
              "decimal_places": 2,
              "ge": 0,
              "le": "92233720368547758.07",
              "title": "Final Price",
              "type": "string"
            },
            "discount_source": {
              "enum": [
                "promotion",
                "pix",
                "none"
              ],
              "title": "Discount Source",
              "type": "string"
            },
            "promotion_id": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Promotion Id"
            },
            "eligible_installments": {
              "default": [],
              "items": {
                "$ref": "#/$defs/InstallmentPlan"
              },
              "title": "Eligible Installments",
              "type": "array"
            }
          },
          "required": [
            "payment_method",
            "discount_percent",
            "final_price",
            "discount_source"
          ],
          "title": "PaymentOffer",
          "type": "object"
        },
        "ProductOffersData": {
          "additionalProperties": false,
          "properties": {
            "product_id": {
              "title": "Product Id",
              "type": "integer"
            },
            "original_price": {
              "decimal_places": 2,
              "ge": 0,
              "le": "92233720368547758.07",
              "title": "Original Price",
              "type": "string"
            },
            "options": {
              "items": {
                "$ref": "#/$defs/PaymentOffer"
              },
              "maxItems": 4,
              "minItems": 1,
              "title": "Options",
              "type": "array"
            },
            "selected_plan": {
              "anyOf": [
                {
                  "$ref": "#/$defs/InstallmentPlan"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "applied_rules": {
              "default": [
                "RN-01",
                "RN-02",
                "RN-03",
                "RN-04",
                "RN-05",
                "RN-11"
              ],
              "items": {
                "type": "string"
              },
              "title": "Applied Rules",
              "type": "array"
            }
          },
          "required": [
            "product_id",
            "original_price",
            "options"
          ],
          "title": "ProductOffersData",
          "type": "object"
        },
        "ToolError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "unknown_tool",
                "invalid_arguments",
                "not_found",
                "ambiguous",
                "unavailable",
                "invalid_installments",
                "forbidden",
                "no_evidence",
                "service_unavailable",
                "response_too_large"
              ],
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            },
            "invalid_fields": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Invalid Fields",
              "type": "array"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "ToolError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProductOffersData"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "data",
        "error"
      ],
      "title": "ToolResponse[ProductOffersData]",
      "type": "object"
    }
