  {
    "name": "search_store_policies",
    "description": "Consulta regras gerais (inclusive parcelas mínimas, sem exigir produto), com seção, página e versão. Use top_k=3 salvo pedido de mais referências.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "top_k": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "PolicySearchInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ChunkMetadata": {
          "additionalProperties": false,
          "properties": {
            "source_name": {
              "title": "Source Name",
              "type": "string"
            },
            "source_sha256": {
              "title": "Source Sha256",
              "type": "string"
            },
            "version": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Version"
            },
            "section_id": {
              "title": "Section Id",
              "type": "string"
            },
            "section_title": {
              "title": "Section Title",
              "type": "string"
            },
            "section_path": {
              "items": {
                "type": "string"
              },
              "title": "Section Path",
              "type": "array"
            },
            "pages": {
              "items": {
                "type": "integer"
              },
              "title": "Pages",
              "type": "array"
            },
            "section_pages": {
              "items": {
                "type": "integer"
              },
              "title": "Section Pages",
              "type": "array"
            }
          },
          "required": [
            "source_name",
            "source_sha256",
            "version",
            "section_id",
            "section_title",
            "section_path",
            "pages",
            "section_pages"
          ],
          "title": "ChunkMetadata",
          "type": "object"
        },
        "PolicyMatchesData": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "matched",
              "title": "Status",
              "type": "string"
            },
            "hits": {
              "items": {
                "$ref": "#/$defs/ToolPolicyHit"
              },
              "maxItems": 5,
              "minItems": 1,
              "title": "Hits",
              "type": "array"
            }
          },
          "required": [
            "status",
            "hits"
          ],
          "title": "PolicyMatchesData",
          "type": "object"
        },
        "ToolError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "unknown_tool",
                "invalid_arguments",
                "not_found",
                "ambiguous",
                "unavailable",
                "invalid_installments",
                "forbidden",
                "no_evidence",
                "service_unavailable",
                "response_too_large"
              ],
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            },
            "invalid_fields": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Invalid Fields",
              "type": "array"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "ToolError",
          "type": "object"
        },
        "ToolPolicyHit": {
          "additionalProperties": false,
          "properties": {
            "chunk_id": {
              "title": "Chunk Id",
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/ChunkMetadata"
            },
            "excerpt": {
              "maxLength": 420,
              "minLength": 1,
              "title": "Excerpt",
              "type": "string"
            },
            "excerpt_truncated": {
              "title": "Excerpt Truncated",
              "type": "boolean"
            },
            "score": {
              "title": "Score",
              "type": "number"
            },
            "lexical_coverage": {
              "title": "Lexical Coverage",
              "type": "number"
            },
            "match_grade": {
              "enum": [
                "strong",
                "partial"
              ],
              "title": "Match Grade",
              "type": "string"
            }
          },
          "required": [
            "chunk_id",
            "metadata",
            "excerpt",
            "excerpt_truncated",
            "score",
            "lexical_coverage",
            "match_grade"
          ],
          "title": "ToolPolicyHit",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyMatchesData"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "data",
        "error"
      ],
      "title": "ToolResponse[PolicyMatchesData]",
      "type": "object"
    }
  },
  {
    "name": "get_store_info",
    "description": "Consulta endereço, horários ou contatos públicos com fontes e ambiguidades.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "enum": [
            "address",
            "hours",
            "contacts"
          ],
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject"
      ],
      "title": "StoreInfoInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "StoreInfo": {
          "additionalProperties": false,
          "properties": {
            "subject": {
              "enum": [
                "address",
                "hours",
                "contacts"
              ],
              "title": "Subject",
              "type": "string"
            },
            "entries": {
              "items": {
                "$ref": "#/$defs/StoreInfoEntry"
              },
              "maxItems": 8,
              "title": "Entries",
              "type": "array"
            },
            "cautions": {
              "items": {
                "type": "string"
              },
              "title": "Cautions",
              "type": "array"
            }
          },
          "required": [
            "subject",
            "entries",
            "cautions"
          ],
          "title": "StoreInfo",
          "type": "object"
        },
        "StoreInfoEntry": {
          "additionalProperties": false,
          "properties": {
            "label": {
              "maxLength": 80,
              "minLength": 1,
              "title": "Label",
              "type": "string"
            },
            "value": {
              "maxLength": 300,
              "minLength": 1,
              "title": "Value",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/StoreInfoSource"
            }
          },
          "required": [
            "label",
            "value",
            "source"
          ],
          "title": "StoreInfoEntry",
          "type": "object"
        },
        "StoreInfoSource": {
          "additionalProperties": false,
          "properties": {
            "source_name": {
              "title": "Source Name",
              "type": "string"
            },
            "source_sha256": {
              "title": "Source Sha256",
              "type": "string"
            },
            "version": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Version"
            },
            "section_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Section Id"
            },
            "pages": {
              "items": {
                "type": "integer"
              },
              "title": "Pages",
              "type": "array"
            }
          },
          "required": [
            "source_name",
            "source_sha256",
            "version",
            "section_id",
            "pages"
          ],
          "title": "StoreInfoSource",
          "type": "object"
        },
        "ToolError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "unknown_tool",
                "invalid_arguments",
                "not_found",
                "ambiguous",
                "unavailable",
                "invalid_installments",
                "forbidden",
                "no_evidence",
                "service_unavailable",
                "response_too_large"
              ],
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            },
            "invalid_fields": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Invalid Fields",
              "type": "array"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "ToolError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoreInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "data",
        "error"
      ],
      "title": "ToolResponse[StoreInfo]",
      "type": "object"
    }
  }
]
