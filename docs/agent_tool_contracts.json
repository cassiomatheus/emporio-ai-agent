[
  {
    "name": "search_products",
    "description": "Busca produtos a partir de um pedido estruturado. Extraia product.category como o tipo pedido pelo cliente, product.subtype como a variante, product.name somente para marca/modelo. characteristics recebe cor, cordas e demais características pedidas; min_price/max_price preservam o orçamento em reais. O backend normaliza categorias e atributos contra o catálogo. Use o objeto product obrigatório, sem espalhar category/subtype na raiz. Formato: {\"product\":{\"category\":\"tipo de instrumento\",\"subtype\":null,\"name\":null},\"characteristics\":{},\"max_price\":null}. Não gere category_id, term, specs, SQL ou identidade do cliente.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "additionalProperties": false,
          "properties": {
            "category": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Category"
            },
            "subtype": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Subtype"
            },
            "name": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            }
          },
          "title": "ProductCriteria",
          "type": "object"
        },
        "characteristics": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxProperties": 10,
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Characteristics",
          "type": "object"
        },
        "min_price": {
          "anyOf": [
            {
              "maxLength": 20,
              "pattern": "^\\d{1,17}(?:\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "maximum": 92233720368547758,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Price"
        },
        "max_price": {
          "anyOf": [
            {
              "maxLength": 20,
              "pattern": "^\\d{1,17}(?:\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "maximum": 92233720368547758,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Price"
        },
        "available_only": {
          "default": true,
          "title": "Available Only",
          "type": "boolean"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "active",
                "discontinued",
                "coming_soon"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "limit": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "product"
      ],
      "title": "CatalogSearchRequest",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "JsonValue": {},
        "ProductDetails": {
          "additionalProperties": false,
          "properties": {
            "product_id": {
              "title": "Product Id",
              "type": "integer"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "category_id": {
              "title": "Category Id",
              "type": "integer"
            },
            "category_name": {
              "title": "Category Name",
              "type": "string"
            },
            "price_brl": {
              "decimal_places": 2,
              "ge": 0,
              "le": "92233720368547758.07",
              "title": "Price Brl",
              "type": "string"
            },
            "description": {
              "title": "Description",
              "type": "string"
            },
            "stock_quantity": {
              "title": "Stock Quantity",
              "type": "integer"
            },
            "status": {
              "enum": [
                "active",
                "discontinued",
                "coming_soon"
              ],
              "title": "Status",
              "type": "string"
            },
            "specs": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "title": "Specs",
              "type": "object"
            },
            "available": {
              "title": "Available",
              "type": "boolean"
            },
            "availability_reason": {
              "enum": [
                "available",
                "out_of_stock",
                "discontinued",
                "coming_soon"
              ],
              "title": "Availability Reason",
              "type": "string"
            }
          },
          "required": [
            "product_id",
            "name",
            "category_id",
            "category_name",
            "price_brl",
            "description",
            "stock_quantity",
            "status",
            "specs",
            "available",
            "availability_reason"
          ],
          "title": "ProductDetails",
          "type": "object"
        },
        "SearchProductsData": {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/ProductDetails"
              },
              "maxItems": 20,
              "title": "Items",
              "type": "array"
            },
            "total": {
              "minimum": 0,
              "title": "Total",
              "type": "integer"
            },
            "limit": {
              "maximum": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "offset": {
              "maximum": 10000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          "required": [
            "items",
            "total",
            "limit",
            "offset"
          ],
          "title": "SearchProductsData",
          "type": "object"
        },
        "ToolError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "unknown_tool",
                "invalid_arguments",
                "not_found",
                "ambiguous",
                "unavailable",
                "invalid_installments",
                "forbidden",
                "no_evidence",
                "service_unavailable",
                "response_too_large"
              ],
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            },
            "invalid_fields": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Invalid Fields",
              "type": "array"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "ToolError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchProductsData"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "data",
        "error"
      ],
      "title": "ToolResponse[SearchProductsData]",
      "type": "object"
    }
  },
